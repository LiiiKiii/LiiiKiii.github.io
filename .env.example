# AI-Pedia Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# OPENAI API Configuration (Optional)
# ============================================================================
# If not provided, system will use rule-based fallback for summaries
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# ============================================================================
# Pipeline Configuration
# ============================================================================
# Default number of keywords to extract
DEFAULT_KEYWORD_COUNT=10

# Similarity threshold for CBF ranking
SIMILARITY_THRESHOLD=0.05

# Number of top resources to return per type
TOP_K_RESOURCES=5

# ============================================================================
# Resource Search Configuration
# ============================================================================
# Maximum results per search source
MAX_RESULTS_PER_SOURCE=20

# Enable/disable specific sources
ENABLE_WIKIPEDIA=True
ENABLE_GOOGLE_SCHOLAR=True
ENABLE_ARXIV=True
ENABLE_YOUTUBE=True
ENABLE_GITHUB=True

# ============================================================================
# Evaluation Configuration
# ============================================================================
# Test corpus path for evaluation
TEST_CORPUS_PATH=./data/test_corpus

# Evaluation output directory
EVAL_OUTPUT_DIR=./test/evaluation_pipeline/results