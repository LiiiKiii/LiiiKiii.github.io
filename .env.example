# AI-Pedia Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# OPENAI API Configuration (Optional)
# ============================================================================
# If not provided, the system will use rule-based fallback for summaries
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# ============================================================================
# Pipeline Configuration
# ============================================================================
DEFAULT_KEYWORD_COUNT=10
SIMILARITY_THRESHOLD=0.05
TOP_K_RESOURCES=5

# ============================================================================
# Resource Search Configuration
# ============================================================================
MAX_RESULTS_PER_SOURCE=20
ENABLE_WIKIPEDIA=True
ENABLE_GOOGLE_SCHOLAR=True
ENABLE_ARXIV=True
ENABLE_YOUTUBE=True
ENABLE_GITHUB=True

# ============================================================================
# Evaluation Configuration
# ============================================================================
# Legacy single-corpus path (still supported for ad hoc runs)
TEST_CORPUS_PATH=./data/test_corpus

# Current focused multi-corpus root used by the dissertation evaluation
TEST_CORPORA_ROOT=./data/test_corpora

# Evaluation output directory
EVAL_OUTPUT_DIR=./test/evaluation_pipeline/results
